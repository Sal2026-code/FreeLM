{
  "name": "freelm",
  "version": "0.1.0",
  "private": true,
  "description": "FreeLM — open-source, unrestricted Gemini Notebook (formerly NotebookLM) replica. Website + mobile app.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@freelm/web",
    "build": "npm run build --workspace=@freelm/shared && npm run build --workspace=@freelm/web",
    "start": "npm run start --workspace=@freelm/web",
    "worker": "npm run worker --workspace=@freelm/web",
    "worker:studio": "npm run worker:studio --workspace=@freelm/web",
    "mobile:install": "npm install --prefix apps/mobile",
    "mobile": "npm run start --prefix apps/mobile",
    "mobile:android": "npm run android --prefix apps/mobile",
    "mobile:ios": "npm run ios --prefix apps/mobile",
    "mobile:build:android": "npm run build:android --prefix apps/mobile",
    "mobile:build:ios": "npm run build:ios --prefix apps/mobile",
    "db:migrate": "npm run db:migrate --workspace=@freelm/web",
    "db:seed": "npm run db:seed --workspace=@freelm/web",
    "db:studio": "npm run db:studio --workspace=@freelm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.23.1": true,
    "ffmpeg-static@5.3.0": true,
    "msgpackr-extract@3.0.4": true,
    "tesseract.js@7.0.0": true
  }
}
