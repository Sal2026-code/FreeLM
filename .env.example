# ---------------------------------------------------------------------------
# FreeLM — environment configuration
#
# Copy this file to `apps/web/.env.local` and fill in the values you need.
#   cp .env.example apps/web/.env.local
#
# Every value here is read at runtime. NEVER hardcode secrets in source.
# ---------------------------------------------------------------------------

# --- Core infrastructure ----------------------------------------------------
FREELM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelm
FREELM_REDIS_URL=redis://localhost:6379

# --- Session / auth ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FREELM_AUTH_SECRET=
# Optional. When set, "Sign in with Google" is enabled and notebooks sync
# across devices. Leave blank to run fully as guest.
FREELM_GOOGLE_CLIENT_ID=
FREELM_GOOGLE_CLIENT_SECRET=

# --- AI provider ------------------------------------------------------------
# The provider adapter supports: openai | gemini | anthropic | openai-compatible
FREELM_AI_PROVIDER=openai

# OpenAI (default) — used for chat, embeddings and TTS
FREELM_OPENAI_API_KEY=
FREELM_OPENAI_BASE_URL=https://api.openai.com/v1
FREELM_OPENAI_CHAT_MODEL=gpt-4o-mini
FREELM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FREELM_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Google Gemini (optional alternative)
FREELM_GEMINI_API_KEY=
FREELM_GEMINI_CHAT_MODEL=gemini-2.5-flash
FREELM_GEMINI_EMBEDDING_MODEL=text-embedding-004
FREELM_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Anthropic (optional alternative)
FREELM_ANTHROPIC_API_KEY=
FREELM_ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenRouter,
# Together, Groq, DeepSeek, Mistral, xAI, Cloudflare Workers AI, ...)
# e.g. FREELM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
FREELM_OPENAI_COMPATIBLE_BASE_URL=
FREELM_OPENAI_COMPATIBLE_API_KEY=
FREELM_OPENAI_COMPATIBLE_CHAT_MODEL=
FREELM_OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Model used to auto-derive a 3-6 word thread title.
FREELM_TITLE_MODEL=

# --- Embeddings / vector store ---------------------------------------------
# The pgvector column width. Changing this requires a migration + re-embed
# (see `npm run db:reembed --workspace=@freelm/web`).
FREELM_EMBEDDING_DIM=1536
# Retrieval depth for RAG. FreeLM allows 4-40.
FREELM_RETRIEVAL_K=12

# --- Web research (Fast Research / Deep Research) ---------------------------
# Keyless DuckDuckGo is used by default. Add a key to upgrade.
FREELM_BRAVE_API_KEY=
FREELM_TAVILY_API_KEY=

# --- Storage ----------------------------------------------------------------
# "local" (default) writes to ./storage. "s3" uses the S3 vars below.
FREELM_STORAGE_DRIVER=local
FREELM_STORAGE_PATH=./storage
FREELM_S3_BUCKET=
FREELM_S3_REGION=auto
FREELM_S3_ENDPOINT=
FREELM_S3_ACCESS_KEY_ID=
FREELM_S3_SECRET_ACCESS_KEY=
FREELM_S3_PUBLIC_URL=

# --- Public URL (used for share links + the mobile app) ---------------------
FREELM_PUBLIC_URL=http://localhost:3000

# --- Google Drive import (optional) ----------------------------------------
FREELM_GOOGLE_DRIVE_CLIENT_ID=
FREELM_GOOGLE_DRIVE_CLIENT_SECRET=

# --- Misc -------------------------------------------------------------------
FREELM_MAX_SOURCE_MB=200
FREELM_MAX_SOURCE_WORDS=500000
FREELM_ENABLE_SANDBOX=true
