{
  "expo": {
    "name": "FreeLM",
    "slug": "freelm",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "freelm",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freelm.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FreeLM uses the camera to scan handwritten notes and worksheets into your notebooks.",
        "NSMicrophoneUsageDescription": "FreeLM uses the microphone to record lectures and voice notes.",
        "NSSpeechRecognitionUsageDescription": "FreeLM uses speech recognition so you can talk to your notebook."
      }
    },
    "android": {
      "package": "com.freelm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0c"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "FreeLM uses the microphone to record lectures and voice notes."
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "freelmApiUrl": "https://free-lm.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3626ad86-b836-48ef-84b7-ce7a65915b87"
      }
    },
    "owner": "salcodes2026s-team"
  }
}
