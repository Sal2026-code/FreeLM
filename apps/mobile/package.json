{
  "name": "@freelm/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "FreeLM mobile app — Expo SDK 58, iOS and Android.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
