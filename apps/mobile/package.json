    "expo-image-picker": "58.0.10",
    "expo-linking": "8.0.11",
    "expo-router": "58.0.24",
    "expo-speech": "58.0.3",
    "expo-splash-screen": "58.0.6",
    "expo-status-bar": "3.0.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "^0.21.4"
